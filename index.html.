    /* 3D Canvas */
    #canvas-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      pointer-events: none;
    }
    
    /* Glassmorphism */
    .glass {
      background: rgba(35, 35, 41, 0.8);
      backdrop-filter: blur(20px);
